// Prisma schema for n8n Health Monitoring Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enums
enum ServerStatus {
  ONLINE
  OFFLINE
  DEGRADED
  UNKNOWN
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
  RUNNING
  FAILED
}

enum ExecutionStatus {
  SUCCESS
  ERROR
  RUNNING
  WAITING
  CANCELLED
}

enum ErrorSeverity {
  CRITICAL
  WARNING
  INFO
}

enum UserRole {
  ADMIN
  MEMBER
}

enum InviteType {
  EMAIL // Sent to specific email
  CODE  // Shareable code anyone can use
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ApiKeyScope {
  READ_SERVERS
  WRITE_SERVERS
  READ_WORKFLOWS
  WRITE_WORKFLOWS
  READ_ERRORS
  WRITE_ERRORS
  AI_ANALYSIS
  ADMIN
}

// Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(MEMBER)
  passwordHash  String?   // bcrypt hash for email/password auth (null for OAuth-only)

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // App relations
  apiKeys        ApiKey[]
  invitesSent    Invite[]   @relation("InviteSender")
  createdServers Server[]   @relation("ServerCreator")
  resolvedErrors ErrorLog[] @relation("ErrorResolver")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Server {
  id              String       @id @default(cuid())
  name            String
  url             String
  apiKey          String       // Encrypted with AES-256-GCM
  apiKeyIv        String?      // IV for encryption
  status          ServerStatus @default(UNKNOWN)
  lastChecked     DateTime?
  pollingInterval Int          @default(30) // in seconds
  enableWebhook   Boolean      @default(false)
  skipSSL         Boolean      @default(false)

  // Track who created
  createdById     String?
  createdBy       User?        @relation("ServerCreator", fields: [createdById], references: [id])

  workflows       Workflow[]
  errors          ErrorLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
}

model Workflow {
  id             String         @id @default(cuid())
  n8nId          String
  name           String
  active         Boolean        @default(false)
  status         WorkflowStatus @default(INACTIVE)
  serverId       String
  server         Server         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  executions     Execution[]
  errors         ErrorLog[]
  lastExecution  DateTime?
  executionCount Int            @default(0)
  avgExecTime    Int            @default(0) // in milliseconds
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([serverId, n8nId])
  @@index([serverId])
  @@index([status])
}

model Execution {
  id           String          @id @default(cuid())
  n8nId        String
  workflowId   String
  workflow     Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status       ExecutionStatus
  startedAt    DateTime
  finishedAt   DateTime?
  duration     Int? // in milliseconds
  mode         String? // e.g., "trigger", "manual", "retry"
  retryOf      String? // execution ID if this is a retry
  data         Json? // execution data summary
  hasFullTrace Boolean         @default(false) // whether we have detailed trace data
  traces       ExecutionTrace[]
  errors       ErrorLog[]
  createdAt    DateTime        @default(now())

  // Sub-workflow correlation - for tracking parent/child execution chains
  parentExecutionId String?
  parentExecution   Execution?  @relation("ExecutionChain", fields: [parentExecutionId], references: [id])
  childExecutions   Execution[] @relation("ExecutionChain")
  correlationId     String?     // Shared ID across execution chain (generated on root)
  rootExecutionId   String?     // ID of the topmost parent execution
  depth             Int         @default(0) // 0 = root, 1 = child, 2 = grandchild, etc.

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@index([parentExecutionId])
  @@index([correlationId])
}

// Detailed execution trace - stores node-by-node execution data for AI analysis
model ExecutionTrace {
  id            String    @id @default(cuid())
  executionId   String
  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeName      String
  nodeType      String
  status        String    // "success" | "error" | "skipped"
  executionTime Int?      // milliseconds
  inputData     String?   // JSON string, truncated to ~10KB
  outputData    String?   // JSON string, truncated to ~10KB
  errorMessage  String?
  errorStack    String?
  orderIndex    Int       // execution order (1, 2, 3...)
  createdAt     DateTime  @default(now())

  @@index([executionId])
  @@index([status])
}

model ErrorLog {
  id          String        @id @default(cuid())
  workflowId  String
  workflow    Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  serverId    String
  server      Server        @relation(fields: [serverId], references: [id], onDelete: Cascade)
  executionId String?
  execution   Execution?    @relation(fields: [executionId], references: [id], onDelete: SetNull)
  message     String
  severity    ErrorSeverity @default(WARNING)
  stackTrace  String?
  nodeType    String? // e.g., "n8n-nodes-base.httpRequest"
  nodeName    String?
  resolved    Boolean       @default(false)
  resolvedAt  DateTime?

  // Proper relation for who resolved this error
  resolvedById   String?
  resolvedByUser User?     @relation("ErrorResolver", fields: [resolvedById], references: [id])

  aiAnalysis  AIAnalysis?
  rcaAnalysis RCAAnalysis?
  timestamp   DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([workflowId])
  @@index([serverId])
  @@index([executionId])
  @@index([severity])
  @@index([resolved])
  @@index([timestamp])
}

model AIAnalysis {
  id            String   @id @default(cuid())
  errorId       String   @unique
  error         ErrorLog @relation(fields: [errorId], references: [id], onDelete: Cascade)
  provider      String // e.g., "openai", "anthropic", "ollama"
  model         String // e.g., "gpt-4-turbo", "claude-3-opus"
  confidence    Int // percentage 0-100
  rootCause     String
  suggestedFix  Json // array of strings
  similarIssues Json // array of { id, workflow, resolution }
  rawResponse   Json? // full API response for debugging
  tokenUsage    Int? // for cost tracking
  createdAt     DateTime @default(now())

  @@index([provider])
}

// Root Cause Analysis with 5 Whys methodology
model RCAAnalysis {
  id              String   @id @default(cuid())
  errorId         String   @unique
  error           ErrorLog @relation(fields: [errorId], references: [id], onDelete: Cascade)

  // 5 Whys Analysis
  symptom         String           // Initial error symptom
  fiveWhysData    Json             // Array of { question, answer, evidence? }
  rootCause       String           // Final root cause determination

  // Gap Analysis
  gapAnalysisData Json             // Array of { name, existed, whyMissed }

  // Recommendations
  quickWins       Json             // < 1 hour fixes
  mediumTerm      Json             // ~ 1 day fixes
  longTerm        Json             // 1+ week fixes

  // Classification
  errorCategory   String           // e.g., "Connection", "Authentication"
  errorPattern    String           // e.g., "ECONNREFUSED", "401"

  // Metadata
  confidence      Int              // 0-100
  dataSource      String           // "live" | "database"

  // AI Provider
  provider        String
  model           String
  skillsUsed      Json             // Array of skill names used
  tokenUsage      Int?
  rawResponse     Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([errorId])
  @@index([errorCategory])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id        String   @id @default(cuid())
  serverId  String
  eventType String // e.g., "workflow.started", "workflow.completed", "workflow.failed"
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([serverId])
  @@index([processed])
  @@index([createdAt])
}

// Invitation system for onboarding users
model Invite {
  id         String       @id @default(cuid())
  type       InviteType
  email      String?      // For EMAIL type only
  code       String?      @unique // For CODE type, e.g., "N8H-ABC123"
  token      String       @unique @default(cuid()) // For email verification link
  role       UserRole     @default(MEMBER)
  status     InviteStatus @default(PENDING)
  maxUses    Int?         // For CODE type: null = unlimited
  useCount   Int          @default(0)
  expiresAt  DateTime?    // null = never expires

  // Who created the invite
  invitedById String
  invitedBy   User   @relation("InviteSender", fields: [invitedById], references: [id])

  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([code])
  @@index([status])
  @@index([expiresAt])
}

// API keys for programmatic access
model ApiKey {
  id         String        @id @default(cuid())
  name       String        // User-provided name, e.g., "CI/CD Pipeline"
  keyPrefix  String        // First 8 chars for display: "n8h_abc1..."
  keyHash    String        @unique // SHA-256 hash of full key
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes     String        @default("[]") // JSON array of ApiKeyScope values
  lastUsedAt DateTime?
  usageCount Int           @default(0)
  expiresAt  DateTime?     // null = never expires
  isActive   Boolean       @default(true)
  revokedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([keyPrefix])
  @@index([isActive])
}

// Password reset tokens
model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}
