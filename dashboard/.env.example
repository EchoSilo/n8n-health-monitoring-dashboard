# Demo Mode (set to 'true' to run with mock data, no database required)
NEXT_PUBLIC_USE_MOCK_DATA=false

# Database (SQLite default for self-hosted, PostgreSQL for enterprise >5 users)
DATABASE_URL="file:./prisma/data/n8n-dashboard.db"

# For PostgreSQL (enterprise):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/n8n_dashboard"

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# OAuth Providers (at least one required for authentication)
# Google OAuth - https://console.developers.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Providers (at least one recommended)
# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# RCA (Root Cause Analysis) Configuration
# Model to use for RCA analysis (default: claude-sonnet-4-20250514)
ANTHROPIC_RCA_MODEL=claude-sonnet-4-20250514
# Default analysis depth: quick, standard, or deep (default: standard)
RCA_DEFAULT_DEPTH=standard
# Time window for execution correlation in milliseconds (default: 30000)
RCA_CORRELATION_WINDOW_MS=30000

# Ollama (local) - defaults to http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Redis (optional, for caching and real-time)
REDIS_URL=redis://localhost:6379

# Encryption key for n8n API keys at rest (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=

# Email provider for invites and password reset (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yourdomain.com
