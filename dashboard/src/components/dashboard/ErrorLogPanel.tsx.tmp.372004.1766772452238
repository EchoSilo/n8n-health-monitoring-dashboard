                    </Box>
                  </Box>
                </Card>
              )}

              {/* Stack Trace */}
              {selectedError.stackTrace && (
                <Card sx={{ overflow: 'hidden' }}>
                  <Box
                    sx={{
                      p: 1.5,
                      display: 'flex',
                      justifyContent: 'space-between',
                      alignItems: 'center',
